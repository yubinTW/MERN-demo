    "fastify": "^5.2.1",
    "fp-ts": "^2.16.9",
    "mongoose": "^8.12.1",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
